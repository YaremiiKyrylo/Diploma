{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "AI": {
    "TokenizerJsonPath": "models/multilingual-e5-small/tokenizer.json",
    "EmbeddingModelPath": "models/multilingual-e5-small/model.onnx"
  },

  "PineconeSettings": {
    "ApiKey": "",
    "Environment": "us-east-1-aws",
    "IndexName": "ai-assistant-index",
    "Dimension": 384,
    "Metric": "cosine"
  },

  "AzureBlobStorage": {
    "ConnectionString": "",
    "ContainerName": "ai-data"
  },

  "LLM": {
    "Groq": {
      "ApiKey": "",
      "ApiUrl": "https://api.groq.com/openai/v1/chat/completions",
      "ModelId": "llama-3.1-8b-instant"
    }
  },

  "ApplicationSettings": {
    "ConnectionString": "",
    "ApiKey": "secret-key"
  },

  "JwtSettings": {
    "Secret": "SuperSecretKeyForAiChatAssistant2026!@#",
    "Issuer": "AiChatAssistantServer",
