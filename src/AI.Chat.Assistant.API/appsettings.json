{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "AI": {
    "_comment": "Download tokenizer.json and model.onnx into models/multilingual-e5-small/ — see models/README.md",
    "TokenizerJsonPath": "models/multilingual-e5-small/tokenizer.json",
    "EmbeddingModelPath": "models/multilingual-e5-small/model.onnx"
  },

  "PineconeSettings": {
    "ApiKey": "pcsk_765ogD_Nf8pzyssjKXoxHdArtAHmhWCohHAD6Hskcpex51mdDYCNx2Sa9aTXCKVbCRRTZ3",
    "Environment": "us-east-1-aws",
    "IndexName": "ai-assistant-index",
    "Dimension": 384,
    "Metric": "cosine"
  },

  "AzureBlobStorage": {
    "ConnectionString": "",
    "ContainerName": "ai-data"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}
